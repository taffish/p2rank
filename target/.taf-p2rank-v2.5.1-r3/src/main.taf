<shell>
taf_p2rank_cache="${TAFFISH_P2RANK_CHEMCOMP_CACHE_PATH:-}"
if test -n "$taf_p2rank_cache"; then
    if test "$(printf '%s' "$taf_p2rank_cache" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_p2rank_cache"; then
        printf >&2 'taf-p2rank: cache path contains unsupported whitespace, comma, colon, or glob characters: %s\n' "$taf_p2rank_cache"
        exit 64
    fi
    if ! test -d "$taf_p2rank_cache" || ! test -w "$taf_p2rank_cache"; then
        printf >&2 'taf-p2rank: TAFFISH_P2RANK_CHEMCOMP_CACHE_PATH is not a writable directory: %s\n' "$taf_p2rank_cache"
        exit 64
    fi
    taf_p2rank_cache="$(CDPATH= cd "$taf_p2rank_cache" 2>/dev/null && pwd -P)"
    if test -z "$taf_p2rank_cache" || test "$(printf '%s' "$taf_p2rank_cache" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_p2rank_cache"; then
        printf >&2 'taf-p2rank: cache path cannot be represented safely by all supported backends\n'
        exit 64
    fi
fi

<taf-app:container:ghcr.io/taffish/p2rank:2.5.1-r3$@[docker/podman: --platform linux/amd64][docker: --user=$(id -u):$(id -g)][docker/podman: $(if test -n "${taf_p2rank_cache:-}"; then printf -- '--volume=%s:/p2rank-cache --env=PDB_CACHE_DIR=/p2rank-cache' "$taf_p2rank_cache"; fi)][apptainer: $(if test -n "${taf_p2rank_cache:-}"; then printf -- '--bind=%s:/p2rank-cache --env=PDB_CACHE_DIR=/p2rank-cache' "$taf_p2rank_cache"; fi)]>
prank ::*ARGV*::
